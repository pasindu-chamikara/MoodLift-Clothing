rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only admins can upload product images, everyone can read
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Users can upload and read their own avatars
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
